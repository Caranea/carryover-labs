# Template only. Review paths, service account and memory limits on the target host.
[Unit]
Description=Carryover Labs API (single writer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=carryover
Group=carryover
WorkingDirectory=/opt/carryover/api
ExecStart=/usr/bin/node /opt/carryover/api/dist/main.js
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=TRUST_LOOPBACK_PROXY=true
Environment=STORAGE_DIR=/var/lib/carryover/live
# Root-owned 0600 file, injected by the secret-management system. Never keep it in source or backups of the store.
EnvironmentFile=/etc/carryover/runtime.env
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/carryover
LimitCORE=0
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target

# Copy to api/.env. Never commit the real file.
PORT=3000
HOST=127.0.0.1
# Set to true only behind a local HTTPS proxy that overwrites forwarding headers.
TRUST_LOOPBACK_PROXY=false

# Meta Model API key. Without it, your own documents can't be read (503); the sample patient
# still works from its recorded answers (api/samples/recorded.json).
META_MODEL_API_KEY=
# Optional overrides (defaults shown):
# META_MODEL_BASE_URL=https://api.meta.ai/v1
# Model calls running at once across all users (1-32). Each page is one paid call.
# MODEL_CONCURRENCY=8
# US dollars of Meta calls allowed per UTC day across all users, priced from the token usage Meta
# reports. Then new documents are refused until midnight UTC; the sample patient never counts.
# MODEL_DAILY_BUDGET_USD=10

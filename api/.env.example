# Demo AI API. Copy to api/.env and add the Meta or Baseten key below.
# Result history is saved in the browser; no sign-in keys are needed.
PORT=3000
HOST=127.0.0.1
# Enable only with the documented local HTTPS gateway; it must overwrite forwarding headers.
TRUST_LOOPBACK_PROXY=false

# Live Meta checks. Leave empty to use local deterministic results only.
# Baseten → Account → API keys. Muse Spark Open is served as meta-models/muse-spark-open-1026.
BASETEN_API_KEY=
# Meta Model API key, used as the fallback when Baseten is unavailable.
META_MODEL_API_KEY=
# Optional overrides (defaults shown):
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# BASETEN_MODEL=meta-models/muse-spark-open-1026
# META_MODEL_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3

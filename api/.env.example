# Copy to api/.env and fill in from https://dashboard.clerk.com → API keys.
# Never commit the real .env file.
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Origins allowed to use session tokens (comma separated).
CLERK_AUTHORIZED_PARTIES=http://localhost:4200

# Where redacted documents are stored. Relative paths are relative to api/.
STORAGE_DIR=./storage

# AES-256-GCM for NEW saved files; required when NODE_ENV=production.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key in an external secret manager and backed up separately from data.
# Never rotate by simply replacing it: older encrypted files need the old key.
# Existing plaintext is readable but is NOT automatically encrypted. Use the
# offline storage inventory/copy-encrypt/compare workflow in docs/operations.md.
STORAGE_ENCRYPTION_KEY=
# Development with an empty key stores plaintext and logs a warning.
# Run one API writer per STORAGE_DIR; use a trusted gateway for public rate limits/TLS.

PORT=3000
HOST=127.0.0.1
# Enable only with the documented local HTTPS gateway; it must overwrite forwarding headers.
TRUST_LOOPBACK_PROXY=false

# Model-assisted extraction (step 2b). Leave empty to use the rules only.
# Baseten → Account → API keys. Muse Spark Open is served as meta-models/muse-spark-open-1026.
BASETEN_API_KEY=
# Meta Model API key, used as the fallback when Baseten is unavailable.
META_MODEL_API_KEY=
# Optional overrides (defaults shown):
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# BASETEN_MODEL=meta-models/muse-spark-open-1026
# META_MODEL_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3

# Demo AI API. Copy to api/.env and add the standard Meta key below.
# Result history is saved in the browser; no sign-in keys are needed.
PORT=3000
HOST=127.0.0.1
# Enable only with the documented local HTTPS gateway; it must overwrite forwarding headers.
TRUST_LOOPBACK_PROXY=false

# Standard Spark and Wonder processing requires META_MODEL_API_KEY. Missing configuration disables live results.
# Legacy offline tools only; the active pipeline excludes Baseten/open/contributor variants.
BASETEN_API_KEY=
# Meta Model API key used by the active image-processing pipeline.
META_MODEL_API_KEY=
# Optional overrides (defaults shown):
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# BASETEN_MODEL=meta-models/muse-spark-open-1026
# META_MODEL_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3

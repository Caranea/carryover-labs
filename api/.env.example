# Copy to api/.env. Never commit the real file.
PORT=3000
HOST=127.0.0.1
# Set to true only behind a local HTTPS proxy that overwrites forwarding headers.
TRUST_LOOPBACK_PROXY=false

# Meta Model API key. Without it the API answers 503 and live results are disabled.
META_MODEL_API_KEY=
# Optional overrides (defaults shown):
# META_MODEL_BASE_URL=https://api.meta.ai/v1
# Model calls running at once across all users (1-32). Each page is one paid call.
# MODEL_CONCURRENCY=8
# Paid model calls allowed per UTC day across all users; then new work is refused until midnight UTC.
# MODEL_DAILY_CALLS=1000

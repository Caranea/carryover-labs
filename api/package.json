{
  "name": "carryover-labs-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meta model job API for Carryover Labs.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "node -e \"fs.rmSync('.test-build', { recursive: true, force: true })\" && tsc -p tsconfig.json --outDir .test-build && node --test \".test-build/**/*.spec.js\""
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "ajv": "^8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.2"
  }
}
